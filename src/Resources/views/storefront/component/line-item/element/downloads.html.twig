{% sw_extends '@Storefront/storefront/component/line-item/element/downloads.html.twig' %}

{% block component_line_item_downloads %}
    {% if lineItem.downloads is defined and lineItem.downloads|length > 0 %}
        {% set extensionMeshCatalog = extension_mesh_download_catalog(lineItem.downloads) %}

        {% if extensionMeshCatalog.managed is empty %}
            {{ parent() }}
        {% else %}
            <div class="order-detail-content-list">
                {% for download in extensionMeshCatalog.normal %}
                    {% if download.accessGranted %}
                        {% sw_include '@Storefront/storefront/component/line-item/element/download-item.html.twig' %}
                    {% endif %}
                {% endfor %}

                {% for entry in extensionMeshCatalog.managed %}
                    {% if entry.download.accessGranted %}
                        <div class="card mb-3">
                            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <span>
                                    <strong class="d-block">
                                        {{ entry.release.technicalName }}
                                    </strong>
                                    <small class="text-body-secondary">
                                        {{ 'extensionMesh.downloads.managedInLicenses'|trans|sw_sanitize }}
                                    </small>
                                </span>
                                <a
                                    class="btn btn-outline-primary btn-sm"
                                    href="{{ path('frontend.extension_mesh.licenses.detail', {
                                        productId: entry.release.productId
                                    }) }}"
                                >
                                    {{ 'extensionMesh.downloads.openLicense'|trans|sw_sanitize }}
                                </a>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
