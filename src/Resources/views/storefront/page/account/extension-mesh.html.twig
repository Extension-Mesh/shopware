{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <div class="account-welcome">
        <h1>{{ 'extensionMesh.account.title'|trans|sw_sanitize }}</h1>
        <p>{{ 'extensionMesh.account.explanation'|trans|sw_sanitize }}</p>

        {% if extensionMeshToken %}
            <div class="card">
                <div class="card-body">
                    <label class="form-label" for="extension-mesh-registry-url">
                        {{ 'extensionMesh.account.registryUrl'|trans|sw_sanitize }}
                    </label>
                    <input
                        id="extension-mesh-registry-url"
                        class="form-control mb-3"
                        type="text"
                        readonly
                        value="{{ extensionMeshRegistryUrl }}"
                    >

                    <label class="form-label" for="extension-mesh-access-token">
                        {{ 'extensionMesh.account.accessToken'|trans|sw_sanitize }}
                    </label>
                    <input
                        id="extension-mesh-access-token"
                        class="form-control font-monospace"
                        type="text"
                        readonly
                        autocomplete="off"
                        value="{{ extensionMeshToken }}"
                    >
                    <p class="form-text">{{ 'extensionMesh.account.secretWarning'|trans|sw_sanitize }}</p>

                    <form method="post" action="{{ path('frontend.extension_mesh.account.rotate') }}">
                        <button class="btn btn-outline-danger" type="submit">
                            {{ 'extensionMesh.account.rotate'|trans|sw_sanitize }}
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                {{ 'extensionMesh.account.noEntitlements'|trans|sw_sanitize }}
            </div>
        {% endif %}
    </div>
{% endblock %}
