<div class="extension-mesh-repositories">
    <sw-skeleton
        v-if="isLoading && !repositories.length && !publication.length"
        variant="detail"
    />

    <template v-else>
        <mt-banner
            v-if="error"
            class="extension-mesh-page__error"
            variant="critical"
        >
            {{ error }}
        </mt-banner>

        <mt-card class="extension-mesh-page__card" :title="$t('extension-mesh.repositories.connectTitle')">
            <template #headerRight>
                    <a
                        v-if="isGithubProvider"
                        class="extension-mesh-token-link"
                        :href="githubTokenUrl"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {{ $t('extension-mesh.repositories.tokenCreate') }}
                    </a>
            </template>

            <div class="extension-mesh-page__form extension-mesh-token-form">
                <mt-select
                    v-if="providerOptions.length > 1"
                    v-model:model-value="provider"
                    :options="providerOptions"
                    :label="$t('extension-mesh.repositories.providerLabel')"
                    :disabled="isLoading"
                    @update:model-value="setApiBaseUrl"
                />

                <mt-text-field
                    v-model="repositoryName"
                    :label="$t('extension-mesh.repositories.repositoryLabel')"
                    :placeholder="$t('extension-mesh.repositories.repositoryPlaceholder')"
                    :disabled="isLoading"
                />

                <div class="extension-mesh-field-group">
                    <mt-text-field
                        v-model="repositoryToken"
                        type="password"
                        autocomplete="new-password"
                        :label="$t('extension-mesh.repositories.tokenLabel')"
                        :help-text="$t('extension-mesh.repositories.tokenHelp')"
                        :disabled="isLoading"
                    />
                </div>

                <mt-select
                    v-model:model-value="mode"
                    :options="modeOptions"
                    :label="$t('extension-mesh.repositories.modeLabel')"
                    :help-text="mode === 'import'
                        ? $t('extension-mesh.repositories.importNotice')
                        : null"
                    :disabled="isLoading"
                />

                <div class="extension-mesh-field-group">
                    <mt-switch
                        v-if="isGithubProvider"
                        v-model="showCustomApiBaseUrl"
                        bordered
                        :label="$t('extension-mesh.repositories.enterpriseToggle')"
                        :disabled="isLoading"
                    />
                    <mt-text-field
                        v-if="showApiBaseUrl"
                        v-model="apiBaseUrl"
                        :label="$t('extension-mesh.repositories.apiBaseUrlLabel')"
                        :help-text="$t('extension-mesh.repositories.apiBaseUrlHelp')"
                        :disabled="isLoading"
                    />
                </div>

                <sw-entity-single-select
                    v-if="mode === 'link'"
                    v-model:value="productId"
                    entity="product"
                    :label="$t('extension-mesh.repositories.productLabel')"
                    :placeholder="$t('extension-mesh.repositories.productPlaceholder')"
                    :disabled="isLoading"
                    show-clearable-button
                />

                <div class="extension-mesh-page__form-actions">
                    <mt-button
                        variant="primary"
                        :disabled="isLoading
                            || !repositoryName.trim()
                            || (mode === 'link' && !productId)"
                        @click="connectRepository"
                    >
                        {{ $t('extension-mesh.repositories.connect') }}
                    </mt-button>
                </div>
            </div>
        </mt-card>

        <mt-card class="extension-mesh-page__card">
            <div class="extension-mesh-page__header">
                <h3>{{ $t('extension-mesh.repositories.connectedTitle') }}</h3>
                <p>{{ $t('extension-mesh.repositories.connectedHelp') }}</p>
            </div>

            <div
                v-if="!repositories.length && !isLoading"
                class="extension-mesh-page__empty"
            >
                {{ $t('extension-mesh.repositories.empty') }}
            </div>

            <sw-data-grid
                v-else
                identifier="extension-mesh-repositories"
                :is-loading="isLoading"
                :data-source="repositories"
                :columns="repositoryColumns"
                :skeleton-item-amount="repositoryLimit"
                :allow-inline-edit="false"
                :allow-column-edit="false"
                :show-settings="false"
                :show-selection="false"
            >
                <template #column-repository="{ item }">
                    {{ item.repository }}
                </template>

                <template #column-technicalName="{ item }">
                    {{ item.technicalName || '—' }}
                </template>

                <template #column-productId="{ item }">
                    <router-link
                        v-if="item.productId && item.enabled"
                        :to="{ name: 'sw.product.detail', params: { id: item.productId } }"
                    >
                        {{ item.productId }}
                    </router-link>
                    <span v-else>—</span>
                </template>

                <template #column-lastSyncedAt="{ item }">
                    <span
                        v-if="item.lastError"
                        class="extension-mesh-page__item-error"
                    >
                        {{ item.lastError }}
                    </span>
                    <span v-else-if="item.onboardingStatus !== 'ready'">
                        {{ repositoryStatusLabel(item) }}
                    </span>
                    <span v-else-if="item.lastSyncedAt">
                        {{ $t('extension-mesh.repositories.lastSynced', {
                            date: item.lastSyncedAt
                        }) }}
                    </span>
                    <span v-else>{{ repositoryStatusLabel(item) }}</span>
                </template>

                <template #actions="{ item }">
                    <sw-context-menu-item
                        :disabled="isLoading
                            || (!item.enabled && item.onboardingStatus !== 'failed')"
                        @click="syncRepository(item.id)"
                    >
                        {{ item.onboardingStatus === 'failed'
                            ? $t('extension-mesh.repositories.retry')
                            : $t('extension-mesh.repositories.sync') }}
                    </sw-context-menu-item>
                    <sw-context-menu-item
                        :disabled="isLoading"
                        @click="editCredential(item.id)"
                    >
                        {{ $t('extension-mesh.repositories.changeToken') }}
                    </sw-context-menu-item>
                    <sw-context-menu-item
                        variant="danger"
                        :disabled="isLoading"
                        @click="unlinkRepository(item.id)"
                    >
                        {{ $t('extension-mesh.repositories.unlink') }}
                    </sw-context-menu-item>
                </template>

                <template #pagination>
                    <sw-pagination
                        :page="repositoryPage"
                        :limit="repositoryLimit"
                        :total="repositoryTotal"
                        :steps="[10, 25, 50]"
                        @page-change="onRepositoryPageChange"
                    />
                </template>
            </sw-data-grid>
        </mt-card>

        <mt-card class="extension-mesh-page__card">
            <div class="extension-mesh-page__header">
                <h3>{{ $t('extension-mesh.publication.title') }}</h3>
                <p>{{ $t('extension-mesh.publication.explanation') }}</p>
                <small v-if="publicationPaths">
                    {{ $t('extension-mesh.publication.paths', publicationPaths) }}
                </small>
            </div>

            <div
                v-if="!publication.length && !isLoading"
                class="extension-mesh-page__empty"
            >
                {{ $t('extension-mesh.publication.empty') }}
            </div>

            <sw-data-grid
                v-else
                identifier="extension-mesh-publications"
                :is-loading="isLoading"
                :data-source="publication"
                :columns="publicationColumns"
                :skeleton-item-amount="publicationLimit"
                :allow-inline-edit="false"
                :allow-column-edit="false"
                :show-settings="false"
                :show-selection="false"
            >
                <template #column-technicalName="{ item }">
                    <strong v-if="!item.validationError">{{ item.technicalName }}</strong>
                    <strong v-else>{{ $t('extension-mesh.publication.rejected') }}</strong>
                </template>

                <template #column-version="{ item }">
                    {{ item.version || '—' }}
                </template>

                <template #column-productId="{ item }">
                    <router-link :to="{ name: 'sw.product.detail', params: { id: item.productId } }">
                        {{ item.productId }}
                    </router-link>
                </template>

                <template #column-validationError="{ item }">
                    <span
                        v-if="item.validationError"
                        class="extension-mesh-page__item-error"
                    >
                        {{ item.validationError }}
                    </span>
                    <span v-else>{{ $t('extension-mesh.publication.published') }}</span>
                </template>

                <template #pagination>
                    <sw-pagination
                        :page="publicationPage"
                        :limit="publicationLimit"
                        :total="publicationTotal"
                        :steps="[10, 25, 50]"
                        @page-change="onPublicationPageChange"
                    />
                </template>
            </sw-data-grid>
        </mt-card>

        <sw-modal
            v-if="credentialRepositoryId"
            :title="$t('extension-mesh.repositories.changeToken')"
            variant="small"
            @modal-close="cancelCredential"
        >
            <mt-text-field
                v-model="credentialToken"
                type="password"
                autocomplete="new-password"
                :label="$t('extension-mesh.repositories.newToken')"
                :disabled="isLoading"
            />

            <template #modal-footer>
                <mt-button
                    variant="secondary"
                    size="small"
                    :disabled="isLoading"
                    @click="cancelCredential"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="primary"
                    size="small"
                    :disabled="isLoading"
                    @click="saveCredential(credentialRepositoryId)"
                >
                    {{ $t('global.default.save') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
</div>
