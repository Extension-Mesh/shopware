<sw-meteor-page
    class="extension-mesh-administration"
    hide-icon
>
    <template #smart-bar-header>
        Extension Mesh
    </template>

    <template #page-tabs>
        <sw-tabs-item :route="{ name: 'extension.mesh.administration.index.registries' }">
            {{ $t('extension-mesh.tabs.registries') }}
        </sw-tabs-item>
        <sw-tabs-item :route="{ name: 'extension.mesh.administration.index.repositories' }">
