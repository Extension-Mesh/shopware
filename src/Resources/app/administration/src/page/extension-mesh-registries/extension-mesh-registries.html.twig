<div class="extension-mesh-registries">
    <sw-skeleton
        v-if="isLoading && !registries.length"
        variant="detail"
    />

    <template v-else>
        <mt-banner
            v-if="error"
            class="extension-mesh-page__error"
            variant="critical"
        >
            {{ error }}
        </mt-banner>

        <sw-meteor-card v-if="canCreate" class="extension-mesh-page__card">
            <div class="extension-mesh-page__header">
                <h3>{{ $t('extension-mesh.registries.addTitle') }}</h3>
                <p>{{ $t('extension-mesh.registries.explanation') }}</p>
            </div>

            <div class="extension-mesh-page__form">
                <mt-text-field
                    v-model="registryUrl"
                    :label="$t('extension-mesh.registries.urlLabel')"
                    :placeholder="$t('extension-mesh.registries.urlPlaceholder')"
                    :disabled="isLoading"
                    @keydown.enter="addRegistry"
                />
                <mt-text-field
                    v-model="accessToken"
                    type="password"
                    autocomplete="new-password"
                    :label="$t('extension-mesh.registries.accessTokenLabel')"
                    :help-text="$t('extension-mesh.registries.accessTokenHelp')"
                    :disabled="isLoading"
                    @keydown.enter="addRegistry"
                />
                <div class="extension-mesh-page__form-actions">
                    <mt-button
                        variant="primary"
                        :disabled="isLoading || !registryUrl.trim()"
                        @click="addRegistry"
                    >
                        {{ $t('global.default.add') }}
                    </mt-button>
                </div>
            </div>
        </sw-meteor-card>

        <sw-meteor-card class="extension-mesh-page__card">
            <div class="extension-mesh-page__header extension-mesh-page__header--actions">
                <div>
                    <h3>{{ $t('extension-mesh.registries.connectedTitle') }}</h3>
                    <p>{{ $t('extension-mesh.registries.connectedHelp') }}</p>
                </div>
                <mt-button
                    v-if="canUpdate"
                    variant="secondary"
                    :disabled="isLoading || !registries.length"
                    @click="refreshRegistries"
                >
                    {{ $t('extension-mesh.registries.refresh') }}
                </mt-button>
            </div>

            <div
                v-if="!registries.length"
                class="extension-mesh-page__empty"
            >
                {{ $t('extension-mesh.registries.empty') }}
            </div>

            <div
                v-for="registry in registries"
                v-else
                :key="registry.id"
                class="extension-mesh-page__item"
            >
                <div class="extension-mesh-page__item-content">
                    <strong>{{ registry.label || registry.url }}</strong>
                    <small>{{ registry.url }}</small>
                    <small v-if="registry.hasCredential">
                        {{ $t('extension-mesh.registries.credentialStored', {
                            fingerprint: registry.credentialFingerprint
                        }) }}
                    </small>
                    <small
                        v-if="registry.lastError"
                        class="extension-mesh-page__item-error"
                    >
                        {{ registry.lastError }}
                    </small>
                </div>

                <div class="extension-mesh-page__item-actions">
                    <mt-button
                        v-if="canUpdate"
                        variant="secondary"
                        size="small"
                        :disabled="isLoading"
                        @click="editCredential(registry.id)"
                    >
                        {{ $t('extension-mesh.registries.changeAccess') }}
                    </mt-button>
                    <mt-button
                        v-if="canDelete"
                        variant="critical"
                        size="small"
                        :disabled="isLoading"
                        @click="requestRemoveRegistry(registry.id)"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-button>
                </div>

                <div
                    v-if="credentialRegistryId === registry.id"
                    class="extension-mesh-page__inline-form"
                >
                    <mt-text-field
                        v-model="credentialToken"
                        type="password"
                        autocomplete="new-password"
                        :label="$t('extension-mesh.registries.newAccessToken')"
                        :help-text="$t('extension-mesh.registries.clearAccessHelp')"
                        :disabled="isLoading"
                    />
                    <mt-button
                        variant="primary"
                        size="small"
                        :disabled="isLoading"
                        @click="saveCredential(registry.id)"
                    >
                        {{ $t('global.default.save') }}
                    </mt-button>
                    <mt-button
                        variant="secondary"
                        size="small"
                        :disabled="isLoading"
                        @click="cancelCredential"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>
                </div>
            </div>
        </sw-meteor-card>

        <sw-modal
            v-if="registryDeleteId"
            :title="$t('extension-mesh.registries.deleteTitle')"
            variant="small"
            @modal-close="cancelRemoveRegistry"
        >
            <p>{{ $t('extension-mesh.registries.deleteConfirm') }}</p>
            <template #modal-footer>
                <mt-button variant="secondary" :disabled="isLoading" @click="cancelRemoveRegistry">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button variant="critical" :disabled="isLoading" @click="removeRegistry">
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
</div>
