{% block sw_extension_my_extensions_index_smart_bar_search_slot_search_bar %}
<sw-search-bar
    v-if="!extensionMeshIsCustomTab"
    initial-search-type="extension"
    :placeholder="$t('sw-extension.my-extensions.listing.placeholderSearchBar')"
    @search="onSearch"
/>
{% endblock %}

{% block sw_extension_my_extensions_index_smart_bar_tabs_recommendation %}
<sw-tabs-item :route="{ name: 'sw.extension.my-extensions.registries' }">
    {{ $t('extension-mesh.tabs.registries') }}
</sw-tabs-item>

<sw-tabs-item :route="{ name: 'sw.extension.my-extensions.repositories' }">
    {{ $t('extension-mesh.tabs.repositories') }}
</sw-tabs-item>

{% parent %}
{% endblock %}

{% block sw_extension_my_extensions_index_smart_bar_actions_file_upload %}
<sw-extension-file-upload
    v-if="!extensionMeshIsCustomTab
        && acl.can('system.plugin_upload')
        && !extensionManagementDisabled"
/>
{% endblock %}
