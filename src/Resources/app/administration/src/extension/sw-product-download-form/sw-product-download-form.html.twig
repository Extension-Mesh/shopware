{% block sw_product_download_form %}
<div class="extension-mesh-product-downloads">
    <mt-switch
        v-if="extensionMeshStatusLoaded"
        class="extension-mesh-product-downloads__switch"
        :label="$t('extension-mesh.productDownloads.connect')"
        :help-text="extensionMeshRepositoryManaged
            ? $t('extension-mesh.productDownloads.repositoryManaged')
            : $t('extension-mesh.productDownloads.connectHelp')"
        :disabled="disabled || extensionMeshLoading || extensionMeshRepositoryManaged"
        :model-value="extensionMeshEnabled"
        @update:model-value="updateExtensionMeshIntegration"
    />

    <div
        v-if="extensionMeshEnabled"
        class="sw-product-download-form"
        :class="{ 'is--disabled': disabled }"
    >
        <sw-upload-listener
            v-if="!isLoading"
            :upload-tag="`downloads-${product.id}`"
            auto-upload
            @media-upload-finish="successfulUpload"
            @media-upload-fail="onUploadFailed"
        />

        <sw-media-upload-v2
            v-if="!isLoading && acl.can('product.editor')"
            :class="swFieldClasses"
            variant="regular"
            :upload-tag="`downloads-${product.id}`"
            :private-filesystem="true"
            :extension-accept="fileAccept"
            default-folder="product_download"
            v-bind="$attrs"
        />

        <sw-field-error :error="error" />

        <sw-data-grid
            identifier="extension-mesh-product-downloads"
            :is-loading="extensionMeshLoading"
            :data-source="extensionMeshDownloads"
            :columns="extensionMeshColumns"
            :skeleton-item-amount="extensionMeshLimit"
            :allow-inline-edit="false"
            :allow-column-edit="false"
            :show-settings="false"
            :show-selection="false"
        >
            <template #column-version="{ item }">
                {{ item.version || '—' }}
            </template>

            <template #column-shopware="{ item }">
                {{ item.shopware || '—' }}
            </template>

            <template #column-publicationStatus="{ item }">
                <span
                    :class="{
                        'extension-mesh-product-downloads__status--rejected':
                            item.publicationStatus === 'rejected'
                    }"
                >
                    {{ extensionMeshStatusLabel(item) }}
                </span>
                <small
                    v-if="item.validationError"
                    class="extension-mesh-product-downloads__validation-error"
                >
                    {{ item.validationError }}
                </small>
            </template>

            <template #column-fileSize="{ item }">
                {{ extensionMeshFileSize(item) }}
            </template>

            <template #column-createdAt="{ item }">
                {{ extensionMeshDate(item) }}
            </template>

            <template #actions="{ item }">
                <sw-context-menu-item
                    variant="danger"
                    :disabled="extensionMeshLoading || !acl.can('product.editor')"
                    @click="onRemoveDownload(item)"
                >
                    {{ $t('global.default.remove') }}
                </sw-context-menu-item>
            </template>

            <template #pagination>
                <sw-pagination
                    :page="extensionMeshPage"
                    :limit="extensionMeshLimit"
                    :total="extensionMeshTotal"
                    :steps="[10, 25, 50]"
                    @page-change="onExtensionMeshPageChange"
                />
            </template>
        </sw-data-grid>
    </div>

    <template v-else>
        {% parent %}
    </template>
</div>
{% endblock %}
