{
  "name": "extension-mesh/shopware",
  "description": "ExtensionMesh registry integration for Shopware 6 installations",
  "version": "0.1.0-beta.1",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "ExtensionMesh contributors"
    }
  ],
  "autoload": {
    "psr-4": {
      "ExtensionMesh\\Shopware\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ExtensionMesh\\Shopware\\Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "composer/semver": "^3.4",
    "shopware/core": "~6.7.0",
    "shopware/storefront": "~6.7.0",
    "symfony/http-client": "^7.2",
    "symfony/yaml": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "shopwarelabs/phpstan-shopware": "^0.2.2"
  },
  "extra": {
    "shopware-plugin-class": "ExtensionMesh\\Shopware\\ExtensionMesh",
    "label": {
      "de-DE": "ExtensionMesh",
      "en-GB": "ExtensionMesh"
    },
    "description": {
      "de-DE": "ExtensionMesh verbindet Shopware-6-Installationen mit kompatiblen Extension-Registries für sichere Suche, Validierung, Installation und Updates über den nativen Plugin-Lifecycle.",
      "en-GB": "ExtensionMesh connects Shopware 6 installations to compatible extension registries for secure discovery, validation, installation, and updates through the native plugin lifecycle."
    },
    "manufacturerLink": {
      "de-DE": "https://www.extension-mesh.dev",
      "en-GB": "https://www.extension-mesh.dev"
    },
    "supportLink": {
      "de-DE": "https://www.extension-mesh.dev",
      "en-GB": "https://www.extension-mesh.dev"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=1G",
    "coverage": [
      "phpunit -c phpunit.xml.dist --coverage-clover build/coverage.xml",
      "@php tests/coverage-threshold.php build/coverage.xml 30"
    ],
    "test": [
      "@test:unit",
      "@test:administration"
    ],
    "test:administration": "node --test tests/Administration/*.test.js",
    "test:unit": "phpunit -c phpunit.xml.dist"
  }
}
